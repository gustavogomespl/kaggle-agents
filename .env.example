# LLM provider: openai | anthropic | gemini
LLM_PROVIDER=gemini
# Gemini 3.0 Flash (API identifier)
LLM_MODEL=gemini-3-flash-preview

# --- OpenRouter (gateway OpenAI-compativel) ---
# Roteia qualquer modelo via OpenRouter usando o provider "openai".
# Com OPENAI_BASE_URL customizada, o sistema usa chat completions
# automaticamente (override manual: OPENAI_USE_RESPONSES_API=true|false).
# LLM_PROVIDER=openai
# LLM_MODEL=google/gemini-3-flash-preview
# OPENAI_API_KEY=sk-or-v1-...            # sua OPENROUTER_API_KEY
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# API keys (set the one matching LLM_PROVIDER)
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional - per-role model overrides
# PLANNER_MODEL=gemini-3-flash-preview
# DEVELOPER_MODEL=gemini-3-flash-preview
# EVALUATOR_MODEL=gemini-3-flash-preview

# Optional - Kaggle API (data download / automatic submission)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Optional - LangSmith tracing
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=kaggle-agents

# Optional - Model behavior (thesis protocol: temperature 0.1)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192

# Optional - Workflow settings
MAX_ITERATIONS=5

# Target-blind retrieval protocol.
# In mlebench mode, external search stays active but target sources are filtered.
# Legacy compatibility only; MLE-bench ignores true and remains target-blind.
KAGGLE_AGENTS_ALLOW_SAME_COMP_SOURCES=false

# Sandbox resource limits (RLIMIT_AS/RLIMIT_CPU) applied to generated-code
# subprocesses. Disable on GPU hosts: an address-space cap breaks CUDA/TF
# (fake "CUDA out of memory" with free VRAM, pthread_create failures).
# KAGGLE_AGENTS_ENABLE_LIMITS=false

# Ablation studies (paper experiments): disable one component per run
# KAGGLE_AGENTS_ABLATE_SEARCH=true
# KAGGLE_AGENTS_ABLATE_ROBUSTNESS=true
# KAGGLE_AGENTS_ABLATE_META_EVALUATOR=true
# KAGGLE_AGENTS_ABLATE_ENSEMBLE=true
